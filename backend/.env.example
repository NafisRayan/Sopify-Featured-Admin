# Northstar Admin backend

DATABASE_URL="file:./dev.db"
PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5199"

# Required when AUTH_DISABLED is not true (min 32 chars, cryptographically random):
# SESSION_SECRET="paste-output-of-node-e-crypto-randomBytes-32-hex"
SESSION_SECRET="change-me-in-production"

# Set true for local dev / QA scripts without auth (never in production):
AUTH_DISABLED=false

# Password assigned to all active staff rows during seed (default: northstar123):
# STAFF_DEMO_PASSWORD="northstar123"
