# Northstar Admin backend

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
PORT=4000
CORS_ORIGINS="http://localhost:5173,http://localhost:5199"

# Local demo only. Set false before any shared or production deployment.
AUTH_DISABLED=true

# Required when AUTH_DISABLED=false (min 32 random chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET="paste-generated-value-here"

# Password assigned to all active staff rows during seed (default: northstar123):
# STAFF_DEMO_PASSWORD="northstar123"
