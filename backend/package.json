{
  "name": "northstar-admin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + GraphQL backend for the Northstar Goods admin (Shopify Admin API-style surface)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "prisma generate && nest start",
    "start:dev": "prisma generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "seed:reset": "tsx prisma/seed.ts --reset",
    "check:authz": "node scripts/check-mutation-permissions.mjs",
    "check:seed": "node scripts/check-seed-syntax.mjs",
    "check": "npm run check:authz && npm run check:seed && npm run build"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.2.0",
    "apollo-server-express": "^3.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.23.0",
    "multer": "^2.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
